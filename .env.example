# Local development defaults only. Override these values outside local development.
MYSQL_DATABASE=hive
MYSQL_USER=hive
MYSQL_PASSWORD=hive_local
MYSQL_ROOT_PASSWORD=hive_root_local
MYSQL_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/hive?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=hive
DB_PASSWORD=hive_local
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=hive-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
WS_ALLOWED_ORIGINS=http://localhost:5173
DOCKER_JAVA_IMAGE=openjdk:21-slim
DOCKER_COMMAND=docker
EXECUTION_TIMEOUT=10s
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=0.5
EXECUTION_MAX_CONCURRENT=2
EXECUTION_RATE_LIMIT_PER_MINUTE=10
